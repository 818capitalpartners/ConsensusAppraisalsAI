# Database
DATABASE_URL=postgresql://dev818:dev818pass@localhost:5432/capital818

# OpenAI
OPENAI_API_KEY=sk-...

# Monday.com
MONDAY_API_TOKEN=...
MONDAY_PIPELINE_BOARD_ID=18402100042
MONDAY_CHECKLIST_BOARD_ID=18402744907

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Email (Brevo)
BREVO_API_KEY=...

# Salesforce (system of record)
# Connected App with "client_credentials" OAuth flow enabled.
# Create at: Setup > App Manager > New Connected App
SALESFORCE_INSTANCE_URL=https://818capital.my.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_API_VERSION=v60.0

# OpenPhone (Quo). Webhook signing secret from OpenPhone dashboard > Webhooks.
# OPENPHONE_API_KEY is used for BOTH inbound verify and outbound SMS send.
#
# Two outbound lines so the main business line doesn't get spam-reported:
#   - OPENPHONE_DEFAULT_NUMBER  — main 818 line; human conversations, callbacks
#   - OPENPHONE_NUDGE_NUMBER    — dedicated proactive-outbound line for the
#                                 portal nudge cron. MUST be A2P 10DLC-registered
#                                 in OpenPhone (Settings → Phone Numbers →
#                                 Register). Falls back to DEFAULT if unset.
OPENPHONE_API_KEY=
OPENPHONE_WEBHOOK_SECRET=
OPENPHONE_DEFAULT_NUMBER=+19179939194
OPENPHONE_NUDGE_NUMBER=

# Cron / scheduled-task auth. Anything calling /api/cron/* must present this
# value as `Authorization: Bearer <secret>` or `?key=<secret>`. Generate a
# fresh random value (e.g. `openssl rand -hex 32`) and store it in Vercel +
# the scheduled-tasks runner config.
CRON_SECRET=

# Supabase (server-side service role). Needed by the nudge cron audit log
# and the Quo webhook handler. SERVICE_ROLE_KEY bypasses RLS — never ship
# to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Follow-up engine
FOLLOWUP_FROM_EMAIL=deals@818capitalpartners.com
FOLLOWUP_FROM_NAME=818 Capital
# comma-separated user ids that get exception tasks
FOLLOWUP_ESCALATION_SF_USER_IDS=

# App
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000
